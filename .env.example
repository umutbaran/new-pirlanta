# --- Veritabanı (Supabase PostgreSQL) ---
# Uygulamanın kullandığı havuzlu bağlantı (Supabase > Connect > Transaction pooler, port 6543)
DATABASE_URL="postgresql://postgres.<proje>:<sifre>@aws-1-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Prisma şema komutları (db push / migrate) için doğrudan bağlantı.
# ÖNEMLİ: 6543 (transaction pooler) OLMAMALI; Session pooler (port 5432) veya Direct connection kullanın.
DIRECT_URL="postgresql://postgres.<proje>:<sifre>@aws-1-eu-central-1.pooler.supabase.com:5432/postgres"

# --- Supabase Storage (ürün görselleri) ---
NEXT_PUBLIC_SUPABASE_URL="https://<proje>.supabase.co"
# Sadece sunucuda kullanılır, asla NEXT_PUBLIC_ ile başlatmayın
SUPABASE_SERVICE_ROLE_KEY=""

# --- Admin girişi (NextAuth) ---
ADMIN_USERNAME=""
# Uzun ve tahmin edilemez bir şifre kullanın
ADMIN_PASSWORD=""
# Üretmek için: openssl rand -base64 32
NEXTAUTH_SECRET=""
# Sitenin tam adresi (yerelde http://localhost:3000)
NEXTAUTH_URL="https://newpirlanta.com"

# --- Site ---
# Sitemap, robots.txt ve paylaşım önizlemelerinde kullanılır
NEXT_PUBLIC_SITE_URL="https://newpirlanta.com"
